# ============================================
# 学习辅助系统 - 环境变量配置模板
# ============================================

# --- LLM 配置 ---
# 支持: openai, modelscope, zhipu, deepseek, custom
LLM_PROVIDER=openai
LLM_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# --- 本地 LLM 备选配置 (当API不可用时) ---
LOCAL_LLM_ENABLED=false
LOCAL_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_PATH=./models/llm
LOCAL_LLM_DEVICE=cpu
LOCAL_LLM_QUANTIZATION=int8

# --- 百炼 Embedding ---
EMBEDDING_PROVIDER=bailian
DASHSCOPE_API_KEY=your-dashscope-api-key-here
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1024

# --- 本地 Embedding 备选配置 ---
LOCAL_EMBEDDING_ENABLED=false
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
LOCAL_EMBEDDING_PATH=./models/embedding
LOCAL_EMBEDDING_DEVICE=cpu

# --- Qdrant 向量数据库 ---
VECTOR_DB_TYPE=qdrant
QDRANT_URL=http://localhost
QDRANT_PORT=6333
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_USE_LOCAL=true
QDRANT_LOCAL_PATH=./data/qdrant_store
QDRANT_COLLECTION_NAME=learning_assistant
VECTOR_DIMENSION=1024

# --- Neo4j 图数据库 ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password-here
NEO4J_DATABASE=neo4j

# --- 检索引擎 ---
SEARCH_ENGINE=serpapi
SERPAPI_API_KEY=your-serpapi-key-here
SEARCH_MAX_RESULTS=5

# --- 记忆模块 ---
MEMORY_MAX_MESSAGES=50
MEMORY_SUMMARY_ENABLED=true
CHECKPOINT_STORE_PATH=./data/checkpoints

# --- 服务器配置 ---
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
