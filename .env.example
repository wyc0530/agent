# ============================================================
# 学习辅助系统 (Learning Assistant System) - 环境变量配置模板
# ============================================================
# 使用说明：
#   1. 复制此文件为 .env：cp .env.example .env
#   2. 根据实际情况填写各项配置
#   3. 标记为 [必填] 的变量必须配置，否则系统无法正常运行
#   4. 标记为 [可选] 的变量可使用默认值
# ============================================================

# ============================================================
# LLM 大语言模型配置
# ============================================================

# LLM 提供商 [可选，默认: openai]
# 可选值: openai | modelscope | zhipu | deepseek | custom
LLM_PROVIDER=openai

# LLM API 密钥 [必填]
# OpenAI: sk-xxx
# ModelScope/智谱/DeepSeek: 对应的 API Key
LLM_API_KEY=sk-your-api-key-here

# LLM 模型名称 [可选，默认: gpt-4o-mini]
# OpenAI: gpt-4o-mini / gpt-4o / gpt-4-turbo
# 智谱: glm-4-plus
# DeepSeek: deepseek-chat
LLM_MODEL=gpt-4o-mini

# LLM API 自定义地址 [可选，默认: https://api.openai.com/v1]
# 使用代理或兼容 API 时修改此项
LLM_BASE_URL=https://api.openai.com/v1

# LLM 生成温度 [可选，默认: 0.7]
# 范围 0.0-2.0，越高越随机
LLM_TEMPERATURE=0.7

# LLM 最大输出 Token 数 [可选，默认: 4096]
LLM_MAX_TOKENS=4096

# ============================================================
# 本地 LLM 配置
# ============================================================

# 是否启用本地 LLM [可选，默认: false]
LOCAL_LLM_ENABLED=false

# 本地 LLM 模型名称 [可选，默认: Qwen/Qwen2.5-7B-Instruct]
LOCAL_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# 本地 LLM 服务地址 [可选，默认: http://localhost:1234/v1]
# 如使用 LM Studio / Ollama 等本地推理服务
LOCAL_LLM_BASE_URL=http://localhost:1234/v1

# 本地 LLM 模型文件路径 [可选，默认: ./models/llm]
LOCAL_LLM_PATH=./models/llm

# 本地 LLM 运行设备 [可选，默认: cpu]
# 可选值: cpu | cuda | mps
LOCAL_LLM_DEVICE=cpu

# 本地 LLM 量化方式 [可选，默认: int8]
# 可选值: int4 | int8 | fp16 | none
LOCAL_LLM_QUANTIZATION=int8

# ============================================================
# Embedding 向量嵌入配置
# ============================================================

# Embedding 提供商 [可选，默认: bailian]
# 可选值: bailian | openai | local
EMBEDDING_PROVIDER=bailian

# 百炼 (DashScope) API 密钥 [Embedding 功能必填]
# 阿里云百炼平台获取: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-dashscope-key-here

# Embedding 模型名称 [可选，默认: text-embedding-v3]
EMBEDDING_MODEL=text-embedding-v3

# Embedding 向量维度 [可选，默认: 1024]
# text-embedding-v3 支持 1024 / 768 / 512
EMBEDDING_DIMENSION=1024

# ============================================================
# 本地 Embedding 配置
# ============================================================

# 是否启用本地 Embedding [可选，默认: false]
LOCAL_EMBEDDING_ENABLED=false

# 本地 Embedding 模型名称 [可选，默认: BAAI/bge-small-zh-v1.5]
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 本地 Embedding 模型文件路径 [可选，默认: ./models/embedding]
LOCAL_EMBEDDING_PATH=./models/embedding

# 本地 Embedding 运行设备 [可选，默认: cpu]
LOCAL_EMBEDDING_DEVICE=cpu

# ============================================================
# Qdrant 向量数据库配置
# ============================================================

# 向量数据库类型 [可选，默认: qdrant]
VECTOR_DB_TYPE=qdrant

# Qdrant 服务地址 [可选，默认: http://localhost]
# 使用 Docker Compose 部署时建议设为 http://qdrant
QDRANT_URL=http://localhost

# Qdrant 服务端口 [可选，默认: 6333]
QDRANT_PORT=6333

# Qdrant API 密钥 [可选，默认: 空]
# 仅 Qdrant Cloud 或启用认证的远程服务器需要
QDRANT_API_KEY=

# 是否使用本地文件模式 [可选，默认: true]
# true: 数据存储在本地磁盘
# false: 连接远程 Qdrant 服务器（需配置 QDRANT_URL）
QDRANT_USE_LOCAL=true

# Qdrant 本地数据存储路径 [可选，默认: ./data/qdrant_store]
QDRANT_LOCAL_PATH=./data/qdrant_store

# Qdrant 集合名称 [可选，默认: learning_assistant]
QDRANT_COLLECTION_NAME=learning_assistant

# 向量维度 [可选，默认: 1024]
# 必须与 EMBEDDING_DIMENSION 保持一致
VECTOR_DIMENSION=1024

# ============================================================
# Neo4j 图数据库配置
# ============================================================

# Neo4j 连接地址 [可选，默认: bolt://localhost:7687]
NEO4J_URI=bolt://localhost:7687

# Neo4j 用户名 [可选，默认: neo4j]
NEO4J_USER=neo4j

# Neo4j 密码 [知识图谱功能必填]
NEO4J_PASSWORD=your-neo4j-password

# Neo4j 数据库名称 [可选，默认: neo4j]
NEO4J_DATABASE=neo4j

# ============================================================
# 搜索配置
# ============================================================

# 搜索引擎 [可选，默认: serpapi]
SEARCH_ENGINE=serpapi

# SerpAPI API 密钥 [Web 搜索功能必填]
# 获取地址: https://serpapi.com/
SERPAPI_API_KEY=your-serpapi-key-here

# 搜索结果最大数量 [可选，默认: 5]
SEARCH_MAX_RESULTS=5

# 自定义搜索引擎 ID (Google Programmable Search) [可选，默认: 空]
SEARCH_ENGINE_ID=

# 搜索超时时间（秒） [可选，默认: 10]
SEARCH_TIMEOUT=10

# ============================================================
# 记忆与对话存档配置
# ============================================================

# 记忆最大保留消息数 [可选，默认: 50]
MEMORY_MAX_MESSAGES=50

# 是否启用对话摘要 [可选，默认: true]
MEMORY_SUMMARY_ENABLED=true

# 对话存档存储路径 [可选，默认: ./data/checkpoints]
CHECKPOINT_STORE_PATH=./data/checkpoints

# ============================================================
# 服务器配置
# ============================================================

# 服务监听地址 [可选，默认: 0.0.0.0]
HOST=0.0.0.0

# 服务端口 [可选，默认: 8000]
PORT=8000

# 调试模式 [可选，默认: false]
# 生产环境务必设为 false
DEBUG=false

# 日志级别 [可选，默认: INFO]
# 可选值: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# 是否启用 API 认证 [可选，默认: false]
# 生产环境建议开启
API_AUTH_ENABLED=false

# API 认证密钥 [API_AUTH_ENABLED=true 时必填]
API_KEY=your-api-key-here

# CSRF 受信来源域名 [可选，生产环境建议配置]
# 设置为前端部署的域名（不含协议），例如: example.com
# 多个域名用逗号分隔
ALLOWED_ORIGIN=localhost